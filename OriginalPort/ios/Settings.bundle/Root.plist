<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>FooterText</key>
			<string>When enabled, the pond will render at your devices full resolution, using the original 3.5-inch iPhone aspect ratio. When disabled, it will render at 320 × 480.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<true/>
			<key>Key</key>
			<string>AllowFullResolution</string>
			<key>Title</key>
			<string>Use Full Resolution</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>When enabled, the pond will render up to 60 FPS, or 120 FPS on ProMotion displays. When disabled, it uses the app's original 24 FPS and simulation logic.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<true/>
			<key>Key</key>
			<string>UnlockFrameRate</string>
			<key>Title</key>
			<string>Unlock Frame Rate</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>When enabled, the app will fill your entire screen. Keep in mind, the actual app window will retain the original 3.5-inch iPhone aspect ratio, so content may be cut off.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
			<false/>
			<key>Key</key>
			<string>FillScreenCropped</string>
			<key>Title</key>
			<string>Fill Screen (Cropped)</string>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
		</dict>
		<dict>
			<key>FooterText</key>
			<string>Force quit the app from the app switcher to apply changes to these settings.</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
	</array>
	<key>StringsTable</key>
	<string>Root</string>
</dict>
</plist>
